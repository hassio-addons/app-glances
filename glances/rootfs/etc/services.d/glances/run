#!/usr/bin/env bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: Glances
# Runs Glances
# ==============================================================================
declare -a options=()
declare -a exporters=()

bashio::log.info 'Starting Glances...'

options+=(-C /etc/glances.conf)
options+=(-w)
options+=(--port 61209)
options+=(--bind 127.0.0.1)
options+=(--time "$(bashio::config 'refresh_time')")

if bashio::config.false 'process_info'; then
    options+=(--disable-process)
fi

if bashio::config.true 'influxdb.enabled'; then
    if bashio::config.equals 'influxdb.version' '2'; then
        exporters+=(influxdb2)
    else
        exporters+=(influxdb)
    fi
fi

if bashio::debug; then
    options+=(--debug)
fi

# Without an exporter configured, Glances is the only process to run.
if (( ${#exporters[@]} == 0 )); then
    exec glances "${options[@]}"
fi

# Glances v4 refuses to export while running as a web server; exporting is
# only available in standalone or client mode. A second, quiet, standalone
# Glances instance therefore handles the exporting.
# https://github.com/nicolargo/glances/issues/614
declare -a exporter_options=()
exporter_options+=(-C /etc/glances.conf)
exporter_options+=(--quiet)
exporter_options+=(--time "$(bashio::config 'refresh_time')")
exporter_options+=(--export "$(IFS=,; echo "${exporters[*]}")")

if bashio::config.false 'process_info'; then
    exporter_options+=(--disable-process)
fi

if bashio::debug; then
    exporter_options+=(--debug)
fi

# Ask the given processes to stop, giving them room to shut down gracefully
# before resorting to SIGKILL, and wait for all of them to be gone.
terminate_processes() {
    local timeout=$1
    local elapsed=0
    local pid
    shift

    kill "$@" 2>/dev/null || true

    for pid in "$@"; do
        while kill -0 "${pid}" 2>/dev/null; do
            if (( elapsed >= timeout )); then
                bashio::log.warning \
                    "Glances did not stop within ${timeout}s, sending SIGKILL..."
                kill -9 "$@" 2>/dev/null || true
                break 2
            fi
            sleep 1
            elapsed=$(( elapsed + 1 ))
        done
    done

    for pid in "$@"; do
        wait "${pid}" 2>/dev/null || true
    done
}

# The exporter quits when its target is unreachable, for example when InfluxDB
# is down or has not started up yet. Restart it instead of tearing down the
# app, so the web interface stays available regardless of the exporter state.
exporter_child_pid=''

# Stop the exporter currently being supervised, if any, and wait for it to
# actually be gone before giving up supervision. This app runs in the host PID
# namespace, so only ever signal a PID that is known to still be our child.
# shellcheck disable=SC2329  # Invoked indirectly, via trap
stop_exporter() {
    trap '' TERM INT

    # Stay below the timeout of stop_glances, so the exporter is killed from
    # here, rather than this supervisor being killed and the exporter orphaned.
    if bashio::var.has_value "${exporter_child_pid}"; then
        terminate_processes 20 "${exporter_child_pid}"
    fi

    exit 0
}

exporter_supervisor() {
    trap stop_exporter TERM INT

    while true; do
        glances "${exporter_options[@]}" &
        exporter_child_pid=$!
        wait "${exporter_child_pid}" || true
        exporter_child_pid=''
        bashio::log.warning 'Glances exporter exited, restarting...'
        sleep 10
    done
}

bashio::log.info 'Starting Glances exporter...'
exporter_supervisor &
readonly EXPORTER_PID=$!

glances "${options[@]}" &
readonly WEBSERVER_PID=$!

# Forward a stop request to both processes, giving them room to shut down
# gracefully before resorting to SIGKILL.
# shellcheck disable=SC2329  # Invoked indirectly, via trap
stop_glances() {
    trap '' TERM INT

    bashio::log.info 'Stopping Glances...'
    terminate_processes 30 "${EXPORTER_PID}" "${WEBSERVER_PID}"

    bashio::log.info 'Glances stopped'
    exit 0
}
trap stop_glances TERM INT

# Getting here means either the web server or the exporter supervisor is gone.
# Stop whatever is left and wait for it to be gone before letting the app be
# restarted. The PID that already exited has been reaped, and could belong to
# another process in the host PID namespace by now, so it is not signalled.
exited_pid=''
wait -n -p exited_pid || true
trap '' TERM INT
bashio::log.warning 'Glances exited unexpectedly, stopping...'

declare -a remaining_pids=()
for pid in "${EXPORTER_PID}" "${WEBSERVER_PID}"; do
    if [[ "${pid}" != "${exited_pid}" ]]; then
        remaining_pids+=("${pid}")
    fi
done
terminate_processes 30 "${remaining_pids[@]}"
exit 1
